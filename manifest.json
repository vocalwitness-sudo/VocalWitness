{
  "name": "VocalWitness",
  "short_name": "VocalWitness",
  "description": "Privacy First • Truth • Evidence • Public Square",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#0a0f1c",
  "theme_color": "#10b981",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/index.html?share=true",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*", "audio/*"]
        }
      ]
    }
  }
}
