{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/witness-voice", "destination": "/witness-voice.html" },
      { "source": "/about", "destination": "/about.html" },
      { "source": "/privacy", "destination": "/privacy.html" },
      { "source": "/terms", "destination": "/terms.html" },
      { "source": "/safety", "destination": "/safety.html" },
      { "source": "/groups", "destination": "/groups.html" },
      { "source": "/my-testimonies", "destination": "/my-testimonies.html" },
      { "source": "/dao", "destination": "/dao.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/moderation", "destination": "/moderation.html" },
      { "source": "/forensic-ledger", "destination": "/forensic-ledger.html" },
      { "source": "/true-witness", "destination": "/true-witness.html" },
      { "source": "/verify", "destination": "/verify.html" },
      { "source": "/transparency", "destination": "/transparency.html" },
      { "source": "/legal", "destination": "/legal.html" },
      { "source": "/live-arena", "destination": "/live-arena.html" },
      { "source": "/p/**", "function": "ogPost" },
      { "source": "/share/**", "function": "ogPost" },
      { "source": "/profile", "destination": "/profile.html" },
      { "source": "/governance", "destination": "/governance.html" }
    ],
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "functions/**",
      ".git/**",
      ".github/**",
      "package.json",
      "package-lock.json",
      "vite.config.js",
      "input.css",
      "DEPLOY_CHECKLIST.md",
      "*.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "unsafe-none"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(self), geolocation=(), payment=(self)"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://www.gstatic.com https://apis.google.com https://accounts.google.com https://www.google.com https://www.gstatic.com/recaptcha/ https://www.recaptcha.net https://js.paystack.co https://static.cloudflareinsights.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://challenges.cloudflare.com https://*.cloudflare.com;"         }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/css; charset=utf-8"
          }
        ]
      },
      {
        "source": "c2pa/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.wasm",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          },
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.zkey",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
