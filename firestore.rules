rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.moderator == true ||
        request.auth.token.admin == true
      );
    }

    function isNotBanned() {
      return isAuthenticated() && request.auth.token.banned != true;
    }

    // CLOUDFLARE R2 & GOOGLE PROFILE MEDIA URL VALIDATION
    function isValidMediaUrl(url) {
      return url is string && (
        url == '' || 
        url.matches('^https://media\\.vocalwitness\\.com/.*') ||
        url.matches('^https://lh3\\.googleusercontent\\.com/.*')
      );
    }

    // SERVER-SIDE TRUST CHECK: Fetches the caller's Firestore doc
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasMinTier(requiredTier) {
      let u = getUserData();
      return isNotBanned() && (
        u.tier == requiredTier ||
        (requiredTier == 'citizen' && (u.tier == 'citizen_circle' || u.tier == 'witness_circle' || u.tier == 'elite_witness' || u.tier == 'steward')) ||
        (requiredTier == 'citizen_circle' && (u.tier == 'witness_circle' || u.tier == 'elite_witness' || u.tier == 'steward')) ||
        (requiredTier == 'witness_circle' && (u.tier == 'elite_witness' || u.tier == 'steward')) ||
        (requiredTier == 'elite_witness' && u.tier == 'steward')
      );
    }

    function isSafeUserCreation() {
      let data = request.resource.data;
      let keys = data.keys();

      return data.uid == request.auth.uid
        && data.uid is string
        && data.email is string
        && data.displayName is string
        && (data.tier == 'citizen' || data.tier == 'citizen_circle')
        && data.isVerified == false
        && !keys.hasAny([
             'role', 'isBanned', 'badges', 'admin', 'moderator',
             'zkVerified', 'reputation', 'score', 'steward'
           ]);
    }

    function isSafeUserUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;

      // IMMUTABLE PRIVILEGED FIELDS - Clients CANNOT modify these directly
      let forbidden = [
        'role', 'isBanned', 'badges', 'admin', 'moderator',
        'zkVerified', 'reputation', 'score', 'tier', 'isVerified', 'uid'
      ];

      let allowed = [
        'email', 'displayName', 'photoURL', 'bio',
        'location', 'website', 'updatedAt', 'lastLoginAt',
        'theme', 'language', 'interestedInArena', 'arenaNotifyAt', 'lastNameChange',
        'hasVerifiedPhone'
      ];

      return !affected.hasAny(forbidden)
        && affected.hasOnly(allowed)
        && (!('email' in data) || data.email is string)
        && (!('displayName' in data) || data.displayName is string)
        && (!('photoURL' in data) || isValidMediaUrl(data.photoURL))
        && (!('bio' in data) || data.bio is string)
        && (!('interestedInArena' in data) || data.interestedInArena is bool);
    }

    function isValidNotification() {
      let data = request.resource.data;
      return data.keys().hasAll(['senderId', 'type', 'timestamp'])
        && data.senderId == request.auth.uid
        && data.senderId is string
        && data.type is string
        && data.type in ['mention', 'reply', 'vote', 'system', 'witness_alert']
        && data.timestamp is timestamp;
    }

    // ==========================================
    // RATE LIMITS
    // ==========================================
    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isSafeUserCreation();
      allow update: if (isOwner(userId) && isSafeUserUpdate()) || isAdmin();
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update, delete: if isOwner(userId);
        allow create: if isNotBanned() && isValidNotification();
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
