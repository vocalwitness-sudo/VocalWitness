rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // INDEX REMINDER
    // ==========================================
    // testimonies: channel ASC, createdAt DESC
    // testimonies: feedVisibility ASC, createdAt DESC
    // posts: visibilityDoor ASC, createdAt DESC
    // corroborations: testimonyId ASC, createdAt DESC
    // verifiable_docs: userId ASC, type ASC, createdAt ASC
    // testimonies/{id}/reactions: type ASC (optional)

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function isNotThrottled() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !('lastTestimonyAt' in getUserData())
        || !(getUserData().lastTestimonyAt is timestamp)
        || request.time > getUserData().lastTestimonyAt + duration.value(30, 's');
    }

    function isWitnessCircle() {
      return isAuthenticated() && (
        request.auth.token.tier == 'witness_circle' ||
        request.auth.token.zkVerified == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (getUserData().tier == 'witness_circle' || getUserData().zkVerified == true))
      );
    }

    function isSteward() {
      return isAuthenticated() && (
        request.auth.token.tier == 'steward' ||
        request.auth.token.steward == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().tier == 'steward')
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.moderator == true ||
        request.auth.token.admin == true ||
        isSteward()
      );
    }

    function isNotBanned() {
      return isAuthenticated()
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || getUserData().get('isBanned', false) != true
        );
    }

    function isValidMediaUrl(url) {
      return url is string && (
        url == '' ||
        url.matches('^https://media\\.vocalwitness\\.com/.*') ||
        url.matches('^https://lh[0-9]+\\.googleusercontent\\.com/.*') ||
        url.matches('^https://firebasestorage\\.googleapis\\.com/.*') ||
        url.matches('^https://.*\\.r2\\.cloudflarestorage\\.com/.*')
      );
    }

    function isSafeUserCreation() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && (!('tier' in request.resource.data) || request.resource.data.tier in ['citizen', 'citizen_circle'])
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
        && !request.resource.data.keys().hasAny([
             'role', 'isBanned', 'badges', 'admin', 'moderator', 'score', 'steward',
             'isPhoneVerified', 'hasVerifiedPhone', 'phoneVerifiedAt', 'reputation',
             'credibilityScore', 'zkVerified', 'weeklyPoints',
             'phoneNumber', 'phone', 'phoneHash'
           ]);
    }

    function isSafeUserUpdate() {
      let forbidden = [
        'role', 'isBanned', 'badges', 'admin', 'moderator',
        'zkVerified', 'score', 'isVerified', 'uid', 'tier',
        'hasVerifiedPhone', 'isPhoneVerified', 'phoneVerifiedAt',
        'reputation', 'credibilityScore', 'weeklyPoints',
        'phoneNumber', 'phone', 'phoneHash', 'humanityScore'
      ];
      let allowed = [
        'email', 'displayName', 'photoURL', 'bio',
        'location', 'website', 'region', 'username',
        'updatedAt', 'lastLoginAt', 'lastLogin', 'lastActive', 'lastUpdated',
        'theme', 'language', 'interestedInArena', 'arenaNotifyAt', 'lastNameChange',
        'lastTestimonyAt', 'following', 'trusted', 'followers',
        'privacyMode', 'hidePublicInfo',
        'activeWitnessCycle', 'lastCycleStart'
      ];
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(forbidden)
          && changed.hasOnly(allowed)
          && (!('email' in request.resource.data) || request.resource.data.email is string)
          && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
          && (!('photoURL' in request.resource.data)
              || request.resource.data.photoURL == null
              || isValidMediaUrl(request.resource.data.photoURL))
          && (!('bio' in request.resource.data) || request.resource.data.bio is string)
          && (!('interestedInArena' in request.resource.data) || request.resource.data.interestedInArena is bool)
          && (!('following' in request.resource.data) || request.resource.data.following is list)
          && (!('trusted' in request.resource.data) || request.resource.data.trusted is list)
          && (!('followers' in request.resource.data) || request.resource.data.followers is list)
          && (!('privacyMode' in request.resource.data) || request.resource.data.privacyMode is string)
          && (!('hidePublicInfo' in request.resource.data) || request.resource.data.hidePublicInfo is bool)
          && (!('activeWitnessCycle' in request.resource.data) || request.resource.data.activeWitnessCycle is bool)
          && (!('lastCycleStart' in request.resource.data)
              || request.resource.data.lastCycleStart is timestamp
              || request.resource.data.lastCycleStart == request.time);
    }

    function isValidNotification() {
      return request.resource.data.keys().hasAll(['type', 'createdAt'])
        && request.resource.data.type is string
        && request.resource.data.type in [
             'mention', 'reply', 'vote', 'system', 'witness_alert', 'corroboration'
           ]
        && request.resource.data.createdAt is timestamp
        && (
             ('senderId' in request.resource.data && request.resource.data.senderId == request.auth.uid)
             ||
             ('fromUid' in request.resource.data && request.resource.data.fromUid == request.auth.uid)
           );
    }

    // Author: soft-hide anytime; text fix only within 30 min of createdAt.
    // Media, hashes, channel, authorId never change from client.
    function isSafeAuthorTestimonyUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      let withinCorrectionWindow =
          resource.data.createdAt is timestamp
          && request.time < resource.data.createdAt + duration.value(30, 'm');

      let immutableCore = [
        'forensicHash', 'packCoreHash', 'evidencePack',
        'imageUrl', 'videoUrl', 'audioUrl', 'mediaUrl', 'mediaUrls',
        'authorId', 'author', 'isAnonymous',
        'channel', 'postingStyle', 'fieldNoteRole', 'fieldNoteOrg',
        'createdAt',
        'authorTier', 'reputation', 'zkVerified',
        'moderationStatus', 'toxicityScore', 'autoFlaggedReasons',
        'isSynthetic', 'syntheticScore', 'moderationFlags', 'aiCategory',
        'reviewedBy', 'reviewedAt', 'reviewNotes',
        'c2paStatus', 'c2paManifest',
        'reactions', 'corroborationCount', 'corroborationScore',
        'commentsCount', 'isPinned', 'pinnedAt', 'pinnedBy',
        'feedVisibility'
      ];

      let hideFields = [
        'visibility', 'isDeleted', 'hiddenAt', 'hiddenBy', 'hiddenReason', 'updatedAt'
      ];

      if (changed.hasAny(immutableCore)) {
        return false;
      }

      if ('visibility' in request.resource.data
          && request.resource.data.visibility == 'moderator_hidden') {
        return false;
      }

      let onlyHide =
          changed.hasOnly(hideFields)
          && (
               !('visibility' in request.resource.data)
               || request.resource.data.visibility in ['public', 'author_hidden']
             )
          && (
               !('isDeleted' in request.resource.data)
               || request.resource.data.isDeleted is bool
             );

      if (onlyHide) {
        return true;
      }

      let textOrHide = hideFields.concat(['content', 'hashtags', 'mentions']);
      let textEditAllowed =
          withinCorrectionWindow
          && changed.hasOnly(textOrHide)
          && (
               !('content' in request.resource.data)
               || (
                    request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 4000
                  )
             )
          && (
               !('visibility' in request.resource.data)
               || request.resource.data.visibility in ['public', 'author_hidden']
             );

      return textEditAllowed;
    }

    function isSafeAuthorPostUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'moderationStatus', 'toxicityScore', 'autoFlaggedReasons',
        'isSynthetic', 'syntheticScore', 'authorTier',
        'reviewedBy', 'reviewedAt', 'reviewNotes',
        'c2paStatus', 'c2paManifest',
        'authorId', 'visibilityDoor', 'authorDoorPrivacy'
      ]);
    }

    function canCommentOnPost(postId) {
      let post = get(/databases/$(database)/documents/posts/$(postId)).data;
      return post.authorDoorPrivacy == 'open'
        || (post.authorDoorPrivacy == 'zk_only' && isWitnessCircle())
        || request.auth.uid == post.authorId;
    }

    function isPhoneVerifiedUser() {
      return isAuthenticated() && (
        request.auth.token.phone_verified == true
        || request.auth.token.tier == 'citizen_circle'
        || request.auth.token.tier == 'witness_circle'
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (
            getUserData().get('isPhoneVerified', false) == true
            || getUserData().get('hasVerifiedPhone', false) == true
            || getUserData().get('isVerified', false) == true
            || getUserData().get('tier', '') in ['citizen_circle', 'witness_circle', 'verified_citizen']
          )
        )
      );
    }

    function canPinPosts() {
      return isSteward() || isModerator() || isAdmin() || isPhoneVerifiedUser();
    }

    function isSafeTestimonyCreate() {
      let d = request.resource.data;

      let allowedKeys = [
        'content', 'hashtags', 'mentions', 'channel',
        'postingStyle', 'fieldNoteRole', 'fieldNoteOrg',
        'authorId', 'isAnonymous', 'author',
        'forensicHash', 'imageUrl', 'videoUrl', 'audioUrl',
        'mediaUrl', 'mediaUrls',
        'evidencePack', 'packCoreHash',
        'reactions', 'commentsCount', 'isPinned', 'isDeleted',
        'createdAt', 'updatedAt',
        'feedVisibility', 'profileMode',
        'visibility', 'hiddenAt', 'hiddenBy', 'hiddenReason'
      ];

      let citizenChannels = [
        'citizen-talk', 'citizen_talk', 'citizen-circle'
      ];
      let witnessChannels = [
        'witness-voice', 'witness_voice', 'witness-circle'
      ];
      let allChannels = citizenChannels.concat(witnessChannels);

      return d.keys().hasOnly(allowedKeys)
        && d.keys().hasAll(['content', 'createdAt', 'authorId', 'channel'])
        && d.authorId == request.auth.uid
        && d.content is string
        && d.content.size() > 0
        && d.content.size() <= 4000
        && d.channel is string
        && d.channel in allChannels
        && (
             d.channel in citizenChannels
             || isWitnessCircle()
           )
        && (d.createdAt is timestamp || d.createdAt == request.time)
        && (!('forensicHash' in d) || (
              d.forensicHash is string && d.forensicHash.size() == 64
            ))
        && (!('imageUrl' in d) || d.imageUrl == null || isValidMediaUrl(d.imageUrl))
        && (!('videoUrl' in d) || d.videoUrl == null || isValidMediaUrl(d.videoUrl))
        && (!('audioUrl' in d) || d.audioUrl == null || isValidMediaUrl(d.audioUrl))
        && (!('mediaUrl' in d) || d.mediaUrl == null || isValidMediaUrl(d.mediaUrl))
        && (!('mediaUrls' in d) || d.mediaUrls is list)
        && (!('reactions' in d) || (
              d.reactions.keys().hasOnly(['respect', 'truth', 'solidarity', 'impact'])
              && d.reactions.respect == 0
              && d.reactions.truth == 0
              && d.reactions.solidarity == 0
              && d.reactions.impact == 0
            ))
        && (!('commentsCount' in d) || d.commentsCount == 0)
        && (!('isPinned' in d) || d.isPinned == false)
        && (!('isDeleted' in d) || d.isDeleted == false)
        && (!('visibility' in d) || d.visibility == 'public')
        && (!('hashtags' in d) || d.hashtags is list)
        && (!('mentions' in d) || d.mentions is list)
        && (!('isAnonymous' in d) || d.isAnonymous is bool)
        && (!('author' in d) || d.author is string)
        && (!('postingStyle' in d) || d.postingStyle in ['citizen', 'field-note'])
        && (!('feedVisibility' in d) || d.feedVisibility in allChannels
            || d.feedVisibility == 'review_queue')
        && !d.keys().hasAny([
             'authorTier', 'reputation', 'zkVerified',
             'moderationStatus', 'moderationFlags', 'aiCategory',
             'toxicityScore', 'autoFlaggedReasons', 'isSynthetic',
             'syntheticScore', 'reviewedBy', 'reviewedAt', 'reviewNotes',
             'c2paStatus', 'c2paManifest',
             'corroborationCount', 'corroborationScore', 'lastCorroboratedAt'
           ]);
    }

    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isModerator() || isAdmin();
      allow create: if isOwner(userId) && isSafeUserCreation();
      allow update: if isAdmin() || (isOwner(userId) && isSafeUserUpdate());
      allow delete: if isAdmin();

      match /drafts/{draftId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update, delete: if isOwner(userId);
        allow create: if isNotBanned() && isValidNotification();
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      match /following/{targetUid} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /followers/{targetUid} {
        allow read: if true;
        allow write: if isOwner(userId) || request.auth.uid == targetUid;
      }
    }

    match /userContributions/{contribId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'testimonyId', 'createdAt'])
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /witness_voice/{postId} {
      allow read: if true;
      allow create: if isNotBanned()
        && isWitnessCircle()
        && isNotThrottled()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time);
      allow update: if isModerator() || (
        isNotBanned() && resource.data.authorId == request.auth.uid && isSafeAuthorTestimonyUpdate()
      );
      allow delete: if false;
    }

    match /citizen_talk/{postId} {
      allow read: if true;
      allow create: if isNotBanned()
        && isNotThrottled()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time);
      allow update: if isModerator() || (
        isNotBanned() && resource.data.authorId == request.auth.uid && isSafeAuthorTestimonyUpdate()
      );
      allow delete: if false;
    }

    match /testimonies/{testimonyId} {
      allow read: if true;

      allow create: if isNotBanned()
        && isNotThrottled()
        && isSafeTestimonyCreate();

      allow update: if isModerator()
        || (
             isNotBanned()
             && resource.data.authorId == request.auth.uid
             && isSafeAuthorTestimonyUpdate()
           )
        || (
             canPinPosts()
             && isNotBanned()
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['isPinned', 'pinnedAt', 'pinnedBy', 'updatedAt'])
           );

      allow delete: if false;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isNotBanned()
          && isAuthenticated()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasAll(['content', 'authorId', 'createdAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1200
          && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time);
        allow update: if isNotBanned()
          && isAuthenticated()
          && resource.data.authorId == request.auth.uid
          && (!('visibility' in resource.data) || resource.data.visibility == 'public')
          && (!('isDeleted' in resource.data) || resource.data.isDeleted == false)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['content', 'updatedAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1200;
        allow delete: if isAuthenticated()
          && (resource.data.authorId == request.auth.uid || isModerator());
      }

      match /reactions/{uid} {
        allow read: if true;
        allow create: if isNotBanned()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type is string
          && request.resource.data.type in ['respect', 'truth', 'solidarity', 'impact']
          && (request.resource.data.createdAt is timestamp
              || request.resource.data.createdAt == request.time);
        allow update: if isNotBanned()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'updatedAt'])
          && request.resource.data.type in ['respect', 'truth', 'solidarity', 'impact'];
        allow delete: if isNotBanned() && request.auth.uid == uid;
      }

      match /corroborations/{uid} {
        allow read: if true;
        allow create: if isNotBanned()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['weight', 'createdAt'])
          && request.resource.data.weight is number
          && request.resource.data.weight >= 1
          && request.resource.data.weight <= 5
          && (request.resource.data.createdAt is timestamp
              || request.resource.data.createdAt == request.time)
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 280));
        allow update, delete: if false;
      }
    }
    match /groups/{groupId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'creatorId', 'visibility', 'createdAt', 'members', 'memberCount'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.members is list
        && request.resource.data.memberCount is number
        && request.resource.data.memberCount == request.resource.data.members.size();
      allow update: if isNotBanned() && (
        resource.data.creatorId == request.auth.uid
        || request.auth.uid in resource.data.get('admins', [])
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberCount', 'pendingMembers'])
          && request.resource.data.members is list
          && request.resource.data.memberCount is number
          && request.resource.data.memberCount == request.resource.data.members.size()
          && (
            (request.auth.uid in request.resource.data.members
              && !(request.auth.uid in resource.data.members))
            ||
            (!(request.auth.uid in request.resource.data.members)
              && request.auth.uid in resource.data.members)
            ||
            (request.auth.uid in request.resource.data.get('pendingMembers', []))
          )
        )
      );
      allow delete: if isNotBanned()
        && resource.data.creatorId == request.auth.uid;
    }

    match /group_attestations/{docId} {
      allow read: if request.auth != null;
      allow create: if isNotBanned() && request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isNotBanned()
        && request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.creatorId == request.auth.uid);
    }

    match /group_timeline/{docId} {
      allow read: if request.auth != null;
      allow create: if isNotBanned() && request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isNotBanned()
        && request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.creatorId == request.auth.uid);
    }

    match /witnessCycles/{cycleId} {
      allow read: if isAuthenticated();
      allow create: if isNotBanned()
        && isWitnessCircle()
        && request.resource.data.witnessId == request.auth.uid
        && request.resource.data.status is string
        && request.resource.data.status in ['active', 'ended']
        && (request.resource.data.createdAt is timestamp
            || request.resource.data.createdAt == request.time);
      allow update: if isNotBanned()
        && resource.data.witnessId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'endedAt', 'updatedAt']);
      allow delete: if false;
    }

    match /group_evidence/{evidenceId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && isNotBanned()
        && request.resource.data.groupId is string
        && request.resource.data.depositedBy == request.auth.uid
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 64;
      allow update, delete: if false;
    }

    match /corroborations/{corrId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll(['testimonyId', 'authorId', 'weight', 'createdAt'])
        && request.resource.data.testimonyId is string
        && request.resource.data.authorId is string
        && request.resource.data.weight is number
        && request.resource.data.weight >= 1
        && request.resource.data.weight <= 5
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time)
        && (!('note' in request.resource.data) ||
            (request.resource.data.note is string && request.resource.data.note.size() <= 280));
      allow update, delete: if false;
    }

    match /forensic_ledger/{ledgerId} {
      allow read: if true;
      allow create: if isNotBanned()
        && isWitnessCircle()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 64;
      allow update, delete: if false;
    }

    match /ledger_anchors/{date} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /verifiable_docs/{docId} {
      allow get: if true;
      allow list: if false;
      allow create: if isNotBanned()
        && request.resource.data.keys().hasAll(['userId', 'type', 'createdAt', 'status'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['standard', 'premium']
        && request.resource.data.status == 'active'
        && (request.resource.data.createdAt is timestamp
            || request.resource.data.createdAt == request.time);
      allow update, delete: if false;
    }

    match /dao_comments/{commentId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.proposalId is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 400
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if resource.data.visibilityDoor == 'public_square' ||
                    (resource.data.visibilityDoor == 'citizen_circle' && isAuthenticated()) ||
                    (resource.data.visibilityDoor == 'witness_circle' && isWitnessCircle());
      allow create: if isNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time)
        && (!('mediaUrl' in request.resource.data) || isValidMediaUrl(request.resource.data.mediaUrl));
      allow update: if isModerator() || (
        isNotBanned()
        && resource.data.authorId == request.auth.uid
        && isSafeAuthorPostUpdate()
      );
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isNotBanned()
          && isAuthenticated()
          && canCommentOnPost(postId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasAll(['content', 'authorId', 'createdAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1200
          && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time);
        allow update: if isNotBanned()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt']);
        allow delete: if isAuthenticated()
          && (resource.data.authorId == request.auth.uid || isModerator());
      }
    }

    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isNotBanned()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reason is string;
      allow update, delete: if isModerator();
    }

    match /audit_logs/{auditId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['actionType', 'clientTimestamp', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.actionType is string
        && request.resource.data.actionType.size() > 0
        && request.resource.data.actionType.size() <= 64
        && request.resource.data.clientTimestamp is number
        && (!('action' in request.resource.data) || request.resource.data.action is string);
      allow update, delete: if false;
    }

    match /support_log/{logId} {
      allow read: if isAuthenticated() &&
        (resource.data.giverId == request.auth.uid ||
         resource.data.targetId == request.auth.uid);
      allow create: if isAuthenticated()
        && isNotBanned()
        && request.resource.data.giverId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.strength is number
        && request.resource.data.strength >= 1
        && request.resource.data.strength <= 5
        && request.resource.data.cost is number
        && request.resource.data.reputationGiven is number
        && request.resource.data.keys().hasAll([
          'giverId', 'targetId', 'strength', 'cost',
          'reputationGiven', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /dao_proposals/{proposalId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 800
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.totalVotesFor == 0
        && request.resource.data.totalVotesAgainst == 0
        && request.resource.data.totalVotingPowerSpent == 0
        && request.resource.data.voteLog == {};
      allow update: if isNotBanned()
        && (resource.data.createdBy == request.auth.uid || isModerator())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'status', 'closedAt', 'closedBy',
               'finalResult', 'finalVotesFor', 'finalVotesAgainst',
               'updatedAt', 'commentCount',
               'multiSigSignatures', 'relatedPostId', 'originalDecision'
             ]);
      allow delete: if false;
    }

    match /disputes/{disputeId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.challengerId == request.auth.uid
        && request.resource.data.keys().hasAll([
             'type', 'testimonyId', 'challengerId', 'reason', 'status', 'createdAt'
           ])
        && request.resource.data.type == 'TESTIMONY_CHALLENGE'
        && request.resource.data.testimonyId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 20
        && request.resource.data.reason.size() <= 2000
        && request.resource.data.status == 'OPEN'
        && request.resource.data.resolution == null
        && request.resource.data.resolvedBy == null
        && request.resource.data.resolvedAt == null
        && (request.resource.data.createdAt is timestamp
            || request.resource.data.createdAt == request.time);
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'status', 'resolution', 'resolutionNote',
               'resolvedBy', 'resolvedAt'
             ])
        && request.resource.data.status in ['UPHELD', 'REJECTED']
        && request.resource.data.resolution in ['UPHELD', 'REJECTED'];
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'uid', 'displayName', 'photoURL', 'username',
             'bio', 'region', 'tierBadge', 'updatedAt'
           ])
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    match /liveRooms/{roomId} {
      allow read: if true;

      allow create: if isNotBanned() && isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 6
        && request.resource.data.title.size() <= 120;

      allow update: if isNotBanned() && isAuthenticated() && (
        resource.data.createdBy == request.auth.uid
        || isModerator()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'participantCount',
               'speakingCount',
               'reactions',
               'lastActivityAt'
             ])
      );

      allow delete: if isNotBanned() && isAuthenticated() && (
        resource.data.createdBy == request.auth.uid || isModerator()
      );

      match /participants/{participantId} {
        allow read: if true;
        allow create, update: if isNotBanned() && isAuthenticated()
          && (
            (request.auth.uid == participantId
              && request.resource.data.uid == request.auth.uid)
            ||
            (get(/databases/$(database)/documents/liveRooms/$(roomId)).data.createdBy == request.auth.uid
              && request.resource.data.uid == participantId)
          );
        allow delete: if isAuthenticated() && (
          request.auth.uid == participantId
          || get(/databases/$(database)/documents/liveRooms/$(roomId)).data.createdBy == request.auth.uid
          || isModerator()
        );
      }

      match /corroborations/{corrId} {
        allow read: if true;
        allow create: if isNotBanned() && isAuthenticated()
          && corrId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /sealedSegments/{segmentId} {
        allow read: if true;
        allow create: if isNotBanned() && isAuthenticated()
          && request.resource.data.sealedBy == request.auth.uid
          && request.resource.data.keys().hasAll(['sealedBy', 'displayName', 'sealedAt']);
        allow update, delete: if isModerator();
      }

      match /evidenceDrops/{dropId} {
        allow read: if true;
        allow create: if isNotBanned() && isAuthenticated()
          && request.resource.data.droppedBy == request.auth.uid;
        allow update, delete: if isModerator();
      }

      match /reports/{reportId} {
        allow read: if isModerator() || isAdmin();
        allow create: if isNotBanned() && isAuthenticated()
          && request.resource.data.reportedBy == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isModerator() || isAdmin();
      }
    }
  }
}
