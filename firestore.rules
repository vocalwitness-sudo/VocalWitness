rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId; 
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.moderator == true || 
        request.auth.token.admin == true
      );
    }

    // Prevents self-escalation of roles/tiers on user profile updates
    function isNotModifyingPrivileges() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny(['role', 'tier', 'isBanned', 'badges', 'admin', 'moderator', 'createdAt', 'zkVerified']);
    }

    // Prevents setting sensitive role/tier properties on document creation
    function doesNotContainPrivileges() {
      let keys = request.resource.data.keys();
      return !keys.hasAny(['role', 'tier', 'isBanned', 'badges', 'admin', 'moderator', 'zkVerified']);
    }

    // Schema validator helper for notification creations
    function isValidNotification() {
      let keys = request.resource.data.keys();
      return keys.hasAll(['senderId', 'type', 'timestamp']) 
          && request.resource.data.senderId == request.auth.uid;
    }

  // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && (doesNotContainPrivileges() || request.resource.data.tier == 'citizen');
      allow update: if (isOwner(userId) && isNotModifyingPrivileges()) || isAdmin();
      allow delete: if isAdmin();

      // Subcollection: User Notifications
      match /notifications/{notificationId} {
        // Allows both single document get and collection queries for the document owner
        allow read, get, list: if isOwner(userId);
        allow update, delete: if isOwner(userId);
        
        // Any logged-in user can send a notification to another user
        allow create: if isAuthenticated() && isValidNotification();
      }

      // Subcollection: User Bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }
    // ==========================================
    // VERIFICATION REQUESTS (DEVELOPER & PEER QUEUE)
    // ==========================================
    match /verification_requests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.applicantId || isModerator());
      allow create: if isAuthenticated() && request.resource.data.applicantId == request.auth.uid;
      allow update, delete: if isModerator();
    }

    // ==========================================
    // FEEDS COLLECTION (Citizen Talk & Witness Voice)
    // ==========================================
    match /feeds/{feedId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isModerator());
    }

    // ==========================================
    // WITNESS CYCLES COLLECTION
    // ==========================================
    match /witnessCycles/{cycleId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.witnessId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.witnessId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.witnessId == request.auth.uid || isModerator());
    }

    // ==========================================
    // TESTIMONIES / EVIDENCE LEDGER
    // ==========================================
    match /testimonies/{testimonyId} {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && request.resource.data.authorId == request.auth.uid
                    && (request.resource.data.content is string || request.resource.data.content == null);
                    
      allow update: if isAuthenticated() 
                    && (request.auth.uid == resource.data.authorId || isModerator())
                    && request.resource.data.authorId == resource.data.authorId;
                    
      allow delete: if isAuthenticated() 
                    && (request.auth.uid == resource.data.authorId || isAdmin());
      
      // Subcollection: User Reactions
      match /userReactions/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
      
      // Subcollection: Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isModerator());
      }
    }

    // ==========================================
    // ATTESTATIONS (IMMUTABLE LEDGER)
    // ==========================================
    match /attestations/{attestationId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Strict Immutability
    }

    // ==========================================
    // PHONE VERIFICATION
    // ==========================================
    match /phone_verifications/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // GROUPS COLLECTION
    // ==========================================
    match /groups/{groupId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isModerator());
    }

    // ==========================================
    // POSTS COLLECTION
    // ==========================================
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isModerator());
    }

    // ==========================================
    // PEER VERIFICATION VOTES
    // ==========================================
    match /votes/{voteId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false; // Strict Immutability
    }

    // ==========================================
    // MODERATION & REPORTS COLLECTION
    // ==========================================
    match /reports/{reportId} {
      allow read: if isModerator(); 
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.reportedBy;
      allow update, delete: if isModerator(); 
    }

    // ==========================================
    // AUDIT LOGS (IMMUTABLE)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false; // Strict Immutability
    }

    // ==========================================
    // DAO PROPOSALS & QUADRATIC VOTING
    // ==========================================
    match /dao_proposals/{proposalId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isModerator());
      allow delete: if isAdmin();
    }

  }
}
