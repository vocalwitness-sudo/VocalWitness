rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.moderator == true ||
        request.auth.token.admin == true
      );
    }

    function isNotBanned() {
      return isAuthenticated() && request.auth.token.banned != true;
    }

    function isSafeUserCreation() {
      let data = request.resource.data;
      let keys = data.keys();

      return data.uid == request.auth.uid
          && data.uid is string
          && data.email is string
          && data.displayName is string
          && data.tier == 'citizen'
          && data.isVerified == false
          && !keys.hasAny([
               'role', 'isBanned', 'badges', 'admin', 'moderator',
               'zkVerified', 'reputation', 'score'
             ]);
    }

    function isSafeUserUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;

      let forbidden = [
        'role', 'isBanned', 'badges', 'admin', 'moderator',
        'zkVerified', 'reputation', 'score', 'tier', 'isVerified', 'uid'
      ];

      let allowed = [
        'email', 'displayName', 'photoURL', 'bio',
        'location', 'website', 'updatedAt', 'lastLoginAt',
        'theme', 'language', 'interestedInArena', 'arenaNotifyAt'
      ];

      return !affected.hasAny(forbidden)
          && affected.hasOnly(allowed)
          && (!('email' in data) || data.email is string)
          && (!('displayName' in data) || data.displayName is string)
          && (!('photoURL' in data) || data.photoURL is string)
          && (!('bio' in data) || data.bio is string)
          && (!('interestedInArena' in data) || data.interestedInArena is bool);
    }

    function isValidNotification() {
      let data = request.resource.data;
      return data.keys().hasAll(['senderId', 'type', 'timestamp'])
          && data.senderId == request.auth.uid
          && data.senderId is string
          && data.type is string
          && data.type in ['mention', 'reply', 'vote', 'system', 'witness_alert']
          && data.timestamp is timestamp;
    }

    function isAuthorImmutable(authorField) {
      return request.resource.data[authorField] == resource.data[authorField];
    }

    // ==========================================
    // RATE LIMITS (Backend only)
    // ==========================================
    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if true;

      allow create: if isOwner(userId) && isSafeUserCreation();

      allow update: if (isOwner(userId) && isSafeUserUpdate()) || isAdmin();

      allow delete: if isAdmin();

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update, delete: if isOwner(userId);
        allow create: if isNotBanned() && isValidNotification();
      }

      // Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==========================================
    // VERIFICATION REQUESTS
    // ==========================================
    match /verification_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid || isModerator()
      );

      allow create: if isNotBanned()
                    && request.resource.data.applicantId == request.auth.uid
                    && request.resource.data.applicantId is string;

      allow update, delete: if isModerator();
    }

    // ==========================================
    // FEEDS
    // ==========================================
    match /feeds/{feedId} {
      allow read: if true;

      allow create: if isNotBanned()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId is string;

      allow update: if isNotBanned()
                    && (resource.data.authorId == request.auth.uid || isModerator())
                    && isAuthorImmutable('authorId');

      allow delete: if isAuthenticated()
                    && (resource.data.authorId == request.auth.uid || isModerator());
    }

    // ==========================================
    // WITNESS CYCLES
    // ==========================================
    match /witnessCycles/{cycleId} {
      allow read: if true;

      allow create: if isNotBanned()
                    && request.resource.data.witnessId == request.auth.uid
                    && request.resource.data.witnessId is string;

      allow update: if isNotBanned()
                    && resource.data.witnessId == request.auth.uid
                    && isAuthorImmutable('witnessId');

      allow delete: if isAuthenticated()
                    && (resource.data.witnessId == request.auth.uid || isModerator());
    }

    // ==========================================
    // TESTIMONIES
    // ==========================================
    match /testimonies/{testimonyId} {
      allow read: if true;

      allow create: if isNotBanned()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId is string
                    && request.resource.data.content is string;

      allow update: if isNotBanned()
                    && (request.auth.uid == resource.data.authorId || isModerator())
                    && isAuthorImmutable('authorId');

      allow delete: if isAuthenticated()
                    && (request.auth.uid == resource.data.authorId || isAdmin());

      match /userReactions/{userId} {
        allow read: if true;
        allow create, update: if isOwner(userId) && isNotBanned();
        allow delete: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isNotBanned()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.authorId is string;

        allow update: if isNotBanned()
                      && (resource.data.authorId == request.auth.uid || isModerator())
                      && isAuthorImmutable('authorId');

        allow delete: if isAuthenticated()
                      && (resource.data.authorId == request.auth.uid || isModerator());
      }
    }

    // ==========================================
    // ATTESTATIONS (IMMUTABLE)
    // ==========================================
    match /attestations/{attestationId} {
      allow read: if true;
      allow create: if isNotBanned()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userId is string;
      allow update, delete: if false;
    }

    // ==========================================
    // PHONE VERIFICATION
    // ==========================================
    match /phone_verifications/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // GROUPS
    // ==========================================
    match /groups/{groupId} {
      allow read: if true;

      allow create: if isNotBanned()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId is string;

      allow update: if isNotBanned()
                    && (request.auth.uid == resource.data.ownerId || isModerator())
                    && isAuthorImmutable('ownerId');

      allow delete: if isAuthenticated()
                    && (request.auth.uid == resource.data.ownerId || isModerator());
    }

    // ==========================================
    // POSTS
    // ==========================================
    match /posts/{postId} {
      allow read: if true;

      allow create: if isNotBanned()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId is string;

      allow update: if isNotBanned()
                    && (request.auth.uid == resource.data.authorId || isModerator())
                    && isAuthorImmutable('authorId');

      allow delete: if isAuthenticated()
                    && (request.auth.uid == resource.data.authorId || isModerator());
    }

    // ==========================================
    // VOTES (IMMUTABLE)
    // ==========================================
    match /votes/{voteId} {
      allow read: if true;

      allow create: if isNotBanned()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userId is string
                    && request.resource.data.postId is string
                    && request.resource.data.voteType in ['verify', 'dispute']
                    && request.resource.data.timestamp is timestamp;

      allow update, delete: if false;
    }

    // ==========================================
    // REPORTS
    // ==========================================
    match /reports/{reportId} {
      allow read: if isModerator();

      allow create: if isNotBanned()
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.reportedBy is string;

      allow update, delete: if isModerator();
    }

    // ==========================================
    // AUDIT LOGS (Client Creation Allowed; Immutable)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isNotBanned()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userId is string;
      allow update, delete: if false;
    }

    // ==========================================
    // DAO PROPOSALS
    // ==========================================
    match /dao_proposals/{proposalId} {
      allow read: if true;

      allow create: if isNotBanned()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId is string;

      allow update: if isNotBanned()
                    && (resource.data.authorId == request.auth.uid || isModerator())
                    && isAuthorImmutable('authorId');

      allow delete: if isAdmin();
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
