rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS (Optimized & Hardened)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Single evaluation fetch helper to prevent multi-get execution bill traps
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check token claims first for 0-latency & 0-read-cost checks
    function isWitnessCircle() {
      return isAuthenticated() && (
        request.auth.token.tier == 'witness_circle' ||
        request.auth.token.zkVerified == true ||
        (userExists() && (getUserData().tier == 'witness_circle' || getUserData().zkVerified == true))
      );
    }

    function isSteward() {
      return isAuthenticated() && (
        request.auth.token.tier == 'steward' ||
        request.auth.token.steward == true ||
        (userExists() && getUserData().tier == 'steward')
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.moderator == true ||
        request.auth.token.admin == true ||
        isSteward()
      );
    }

    function isNotBanned() {
      return isAuthenticated()
        && request.auth.token.banned != true
        && (!userExists() || getUserData().isBanned != true);
    }

    function isNotThrottled() {
      return !userExists()
        || !('lastTestimonyAt' in getUserData())
        || request.time > getUserData().lastTestimonyAt + duration.value(30, 's');
    }

    function isValidMediaUrl(url) {
      return url is string && (
        url == '' ||
        url.matches('^https://media\\.vocalwitness\\.com/.*') ||
        url.matches('^https://lh[0-9]+\\.googleusercontent\\.com/.*') ||
        url.matches('^data:image/svg\\+xml;.*')
      );
    }

    function isSafeUserCreation() {
      let data = request.resource.data;
      let keys = data.keys();
      return data.uid == request.auth.uid
        && data.uid is string
        && data.email is string
        && data.displayName is string
        && (data.tier == 'citizen' || data.tier == 'citizen_circle')
        && data.isVerified == false
        // Block zkVerified during raw client-side doc creation
        && !keys.hasAny([
             'role', 'isBanned', 'badges', 'admin', 'moderator', 'score', 'steward',
             'isPhoneVerified', 'hasVerifiedPhone', 'phoneVerifiedAt', 'reputation', 
             'credibilityScore', 'zkVerified'
           ]);
    }

    function isSafeUserUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      let forbidden = [
        'role', 'isBanned', 'badges', 'admin', 'moderator',
        'zkVerified', 'score', 'isVerified', 'uid', 'tier',
        'hasVerifiedPhone', 'isPhoneVerified', 'phoneVerifiedAt',
        'reputation', 'credibilityScore', 'weeklyPoints'
      ];
      let allowed = [
        'email', 'displayName', 'photoURL', 'bio',
        'location', 'website', 'updatedAt', 'lastLoginAt',
        'theme', 'language', 'interestedInArena', 'arenaNotifyAt', 'lastNameChange',
        'lastTestimonyAt', 'following', 'trusted', 'followers'
      ];
      return !affected.hasAny(forbidden)
        && affected.hasOnly(allowed)
        && (!('email' in data) || data.email is string)
        && (!('displayName' in data) || data.displayName is string)
        && (!('photoURL' in data) || isValidMediaUrl(data.photoURL))
        && (!('bio' in data) || data.bio is string)
        && (!('interestedInArena' in data) || data.interestedInArena is bool)
        && (!('following' in data) || data.following is list)
        && (!('trusted' in data) || data.trusted is list)
        && (!('followers' in data) || data.followers is list);
    }

    function isValidNotification() {
      let data = request.resource.data;
      return data.keys().hasAll(['senderId', 'type', 'timestamp'])
        && data.senderId == request.auth.uid
        && data.senderId is string
        && data.type is string
        && data.type in ['mention', 'reply', 'vote', 'system', 'witness_alert']
        && data.timestamp is timestamp;
    }

    function isSafeAuthorTestimonyUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let forbidden = [
        'moderationStatus', 'toxicityScore', 'autoFlaggedReasons',
        'isSynthetic', 'syntheticScore', 'authorTier', 'reviewedBy', 'reviewedAt', 'reviewNotes'
      ];
      return !affected.hasAny(forbidden);
    }

    // ==========================================
    // INTERNAL & SYSTEM COLLECTIONS
    // ==========================================
    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isSafeUserCreation();
      allow update: if (isOwner(userId) && isSafeUserUpdate()) || isAdmin();
      allow delete: if isAdmin();

      match /drafts/{draftId} {
        allow read, write: if isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update, delete: if isOwner(userId);
        allow create: if isNotBanned() && isValidNotification();
      }
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
      match /following/{targetUid} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
      match /followers/{targetUid} {
        allow read: if true;
        allow write: if isOwner(userId) || request.auth.uid == targetUid;
      }
    }

    // ==========================================
    // PRIMARY FEEDS: WITNESS VOICE & CITIZEN TALK
    // ==========================================
    
    // Witness Voice Feed: STRICTLY Protected for ZK Verified / Witness Circle
    match /witness_voice/{postId} {
      allow read: if true;
      allow create: if isNotBanned()
        && isWitnessCircle()
        && isNotThrottled()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000;
      allow update: if isModerator() || (
        isNotBanned() && resource.data.authorId == request.auth.uid && isSafeAuthorTestimonyUpdate()
      );
      allow delete: if (resource.data.authorId == request.auth.uid) || isModerator();
    }

    // Citizen Talk Feed: Open for all authentic Citizens
    match /citizen_talk/{postId} {
      allow read: if true;
      allow create: if isNotBanned()
        && isNotThrottled()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000;
      allow update: if isModerator() || (
        isNotBanned() && resource.data.authorId == request.auth.uid && isSafeAuthorTestimonyUpdate()
      );
      allow delete: if (resource.data.authorId == request.auth.uid) || isModerator();
    }

    // Unified & Global Testimonies Ledger
    match /testimonies/{testimonyId} {
      allow read: if true;

      allow create: if isNotBanned()
        && isNotThrottled()
        && request.resource.data.authorId == request.auth.uid
        && (
             request.resource.data.feedVisibility != 'witness-voice' 
             || isWitnessCircle()
           )
        && (
             (request.resource.data.content is string
              && request.resource.data.content.size() > 0
              && request.resource.data.content.size() <= 2000)
             || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0)
             || (request.resource.data.audioUrl is string && request.resource.data.audioUrl.size() > 0)
           )
        && (request.resource.data.createdAt is timestamp
            || request.resource.data.createdAt == request.time);

      allow update: if isModerator()
        || (
             isNotBanned()
             && resource.data.authorId == request.auth.uid
             && request.resource.data.content.size() <= 2000
             && isSafeAuthorTestimonyUpdate()
           )
        || (
             isNotBanned()
             && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['corroborationCount', 'corroborationScore', 'lastCorroboratedAt'])
           );

      allow delete: if (resource.data.authorId == request.auth.uid) || isModerator();
    }

    // ==========================================
    // CORROBORATIONS & FORENSIC LEDGER
    // ==========================================
    match /corroborations/{corrId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll(['testimonyId', 'authorId', 'weight', 'createdAt'])
        && request.resource.data.testimonyId is string
        && request.resource.data.authorId is string
        && request.resource.data.weight is number
        && request.resource.data.weight >= 1
        && request.resource.data.weight <= 5
        && (!('note' in request.resource.data) || 
            (request.resource.data.note is string && request.resource.data.note.size() <= 280));
      allow update, delete: if false;
    }

    match /forensic_ledger/{ledgerId} {
      allow read: if true;
      allow create: if isNotBanned()
        && isWitnessCircle()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 64;
      allow update, delete: if false;
    }

    // ==========================================
    // GENERAL POSTS & GATED DOORS
    // ==========================================
    match /posts/{postId} {
      allow read: if resource.data.visibilityDoor == 'public_square' ||
                    (resource.data.visibilityDoor == 'citizen_circle' && isAuthenticated()) ||
                    (resource.data.visibilityDoor == 'witness_circle' && isWitnessCircle());

      allow create: if isNotBanned()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time);

      allow update: if isModerator() || (
        isNotBanned() && resource.data.authorId == request.auth.uid
      );

      allow delete: if (resource.data.authorId == request.auth.uid) || isModerator();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isNotBanned() && (
          get(/databases/$(database)/documents/posts/$(postId)).data.authorDoorPrivacy == 'open' ||
          (
            get(/databases/$(database)/documents/posts/$(postId)).data.authorDoorPrivacy == 'zk_only' && 
            isWitnessCircle()
          ) ||
          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
        );
      }
    }

    // ==========================================
    // REPORTS & AUDIT LOGS
    // ==========================================
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isNotBanned()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reason is string;
      allow update, delete: if isModerator();
    }

    match /audit_logs/{auditId} {
      allow read: if isModerator();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ==========================================
    // DAO PROPOSALS
    // ==========================================
    match /dao_proposals/{proposalId} {
      allow read: if true;
      allow create: if isNotBanned()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 800
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if isNotBanned() && (
        resource.data.createdBy == request.auth.uid || isModerator()
      );
      allow delete: if false;
    }
  }
}
