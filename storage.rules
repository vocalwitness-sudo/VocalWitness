rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isModerator() {
      return isSignedIn() && (
        request.auth.token.moderator == true ||
        request.auth.token.admin == true
      );
    }

    function isValidImage() {
      // Removed svg+xml for security (XSS risk). Keep only safe raster formats.
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isValidAudio() {
      return request.resource.contentType.matches('audio/(webm|ogg|mp4|mpeg|wav|x-wav|x-m4a)')
          || request.resource.contentType.matches('audio/webm;codecs=opus');
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime|x-m4v|mkv)');
    }

    function isValidMedia() {
      return isValidImage() || isValidAudio() || isValidVideo();
    }

    function isValidPayload(maxMb) {
      return request.resource.size > 0
          && request.resource.size <= maxMb * 1024 * 1024;
    }

    // ==========================================
    // PATH MATCHERS
    // ==========================================

    // Profile Avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage() && isValidPayload(5);
      allow delete: if isOwner(userId) || isModerator();
    }

    // User directory (legacy / profile images)
    match /users/{userId}/{filename} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage() && isValidPayload(5);
      allow delete: if isOwner(userId) || isModerator();
    }

    // Single Evidence Path (from createPost.js / media-pipeline)
    // Changed: require authentication. No more anonymous metadata bypass.
    match /evidence/{filename} {
      allow read: if true;
      allow create: if isSignedIn()
                    && isValidMedia()
                    && isValidPayload(25);
      allow update: if false;          // Immutable once uploaded
      allow delete: if isModerator();
    }

    // Nested User Evidence Directory
    match /evidence/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidMedia() && isValidPayload(25);
      allow update: if false;          // Prevent overwriting sealed evidence
      allow delete: if isOwner(userId) || isModerator();
    }

    // Witness Evidence Path (higher trust)
    match /witness_evidence/{fileId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && isValidMedia()
                    && isValidPayload(25);
      allow update: if false;
      allow delete: if isModerator();
    }

    // Audio Recordings
    match /audio/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidAudio() && isValidPayload(25);
      allow update: if false;
      allow delete: if isOwner(userId) || isModerator();
    }

    // General Uploads (smaller limit)
    match /uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidMedia() && isValidPayload(15);
      allow update: if false;
      allow delete: if isOwner(userId) || isModerator();
    }

    // Fallback – deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
