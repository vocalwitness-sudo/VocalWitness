rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isModerator() {
      return isSignedIn() && (
        request.auth.token.moderator == true || 
        request.auth.token.admin == true
      );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');
    }

    function isValidAudio() {
      return request.resource.contentType.matches('audio/(webm|ogg|mp4|mpeg|wav|x-wav|x-m4a)')
          || request.resource.contentType.matches('audio/webm;codecs=opus');
    }

    // Added Video Support to align with media-pipeline.js
    function isValidVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime|x-m4v|mkv)');
    }

    function isValidMedia() {
      return isValidImage() || isValidAudio() || isValidVideo();
    }

    function isValidPayload(maxMb) {
      return request.resource.size > 0 
          && request.resource.size <= maxMb * 1024 * 1024;
    }

    // ==========================================
    // PATH MATCHERS
    // ==========================================

    // Profile Avatars & User Directory
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage() && isValidPayload(5);
      allow delete: if isOwner(userId) || isModerator();
    }

    match /users/{userId}/{filename} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage() && isValidPayload(5);
      allow delete: if isOwner(userId) || isModerator();
    }

    // Single Evidence Path (from js/createPost.js)
    match /evidence/{filename} {
      allow read: if true;
      allow create: if (isSignedIn() || request.resource.metadata.isAnonymous == "true")
                    && isValidMedia() 
                    && isValidPayload(25);
      allow update: if false;
      allow delete: if isModerator();
    }

    // Nested User Evidence Directory
    match /evidence/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia() && isValidPayload(25);
      allow delete: if isOwner(userId) || isModerator();
    }

    // Witness Evidence Path
    match /witness_evidence/{fileId} {
      allow read: if true;
      allow create: if (isSignedIn() || request.resource.metadata.isAnonymous == "true")
                    && isValidMedia() 
                    && isValidPayload(25);
      allow update: if false;
      allow delete: if isModerator();
    }

    // Audio Recordings
    match /audio/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidAudio() && isValidPayload(25);
      allow delete: if isOwner(userId) || isModerator();
    }

    // General Uploads
    match /uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidMedia() && isValidPayload(15);
      allow delete: if isOwner(userId) || isModerator();
    }

    // Fallback Security Lock
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
