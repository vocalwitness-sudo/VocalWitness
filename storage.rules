rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isModerator() {
      return isSignedIn() && (
        request.auth.token.moderator == true ||
        request.auth.token.admin == true
      );
    }

    function isValidImage() {
      // No svg+xml (XSS risk). Raster only.
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isValidAudio() {
      return request.resource.contentType.matches('audio/(webm|ogg|mp4|mpeg|wav|x-wav|x-m4a)')
          || request.resource.contentType.matches('audio/webm;codecs=opus');
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime|x-m4v|mkv)');
    }

    function isValidMedia() {
      return isValidImage() || isValidAudio() || isValidVideo();
    }

    function isValidPayload(maxMb) {
      return request.resource.size > 0
          && request.resource.size <= maxMb * 1024 * 1024;
    }

    // ==========================================
    // PATH MATCHERS
    // ==========================================

    // Profile avatars — owner may replace/delete
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage() && isValidPayload(5);
      allow delete: if isOwner(userId) || isModerator();
    }

    // User directory (legacy / profile images) — owner may delete
    match /users/{userId}/{filename} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage() && isValidPayload(5);
      allow delete: if isOwner(userId) || isModerator();
    }

    // ---- SEALED EVIDENCE (no owner delete) ----

    // Flat evidence path
    match /evidence/{filename} {
      allow read: if true;
      allow create: if isSignedIn()
                    && isValidMedia()
                    && isValidPayload(25);
      allow update: if false;
      allow delete: if isModerator();
    }

    // Nested user evidence — sealed once uploaded
    match /evidence/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidMedia() && isValidPayload(25);
      allow update: if false;
      allow delete: if isModerator();
    }

    // Witness evidence — sealed
    match /witness_evidence/{fileId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && isValidMedia()
                    && isValidPayload(25);
      allow update: if false;
      allow delete: if isModerator();
    }

    // Audio used as evidence — sealed (no owner delete)
    match /audio/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidAudio() && isValidPayload(25);
      allow update: if false;
      allow delete: if isModerator();
    }

    // General uploads — still owner-deletable (drafts / non-sealed)
    // If you store sealed testimony media only under evidence/, keep this.
    match /uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidMedia() && isValidPayload(15);
      allow update: if false;
      allow delete: if isOwner(userId) || isModerator();
    }

    // Fallback — deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
