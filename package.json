{
  "name": "vocalwitness",
  "version": "1.0.0",
  "description": "VocalWitness - Truth • Evidence • Public Square",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css --watch",
    "lint": "eslint js/**/*.js functions/**/*.js",
    "emulators": "firebase emulators:start",
    "deploy": "firebase deploy",
    "deploy:hosting": "npm run build:css && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "eslint": "^9.0.0",
    "firebase-tools": "^13.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@google/genai": "^0.1.1",
    "@google-cloud/tasks": "^4.0.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "firebase": "^10.11.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "paystack-api": "^2.0.0",
    "snarkjs": "^0.7.3"
  }
}
