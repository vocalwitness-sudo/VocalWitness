{
  "name": "vocalwitness",
  "version": "1.0.0",
  "description": "VocalWitness - Truth • Evidence • Public Square",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint js/**/*.js functions/**/*.js",
    "test": "node --test",
    "emulators": "firebase emulators:start",
    "predeploy": "npm run lint && npm run build",
    "deploy": "firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "firebase-tools": "^13.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "firebase": "^10.11.0",
    "snarkjs": "^0.7.3"
  }
}
