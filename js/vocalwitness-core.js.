// vocalwitness-core.js
import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
import { getFirestore, doc, getDoc, collection, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";
import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-storage.js";

const auth = getAuth();
const db = getFirestore();
const storage = getStorage();

// ==========================================
// 1. AUTH STATE OBSERVER & PROFILE UI TOGGLES
// ==========================================
export function initAuthObserver() {
    onAuthStateChanged(auth, async (user) => {
        const guestBtns = [
            document.getElementById('guest-action-btn'), 
            document.getElementById('guest-action-btn-mobile')
        ];
        const profileBtns = [
            document.getElementById('profile-btn'), 
            document.getElementById('profile-btn-mobile')
        ];

        if (user) {
            // Hide guest buttons, show profile buttons
            guestBtns.forEach(btn => btn && btn.classList.add('hidden'));
            profileBtns.forEach(btn => {
                if (btn) {
                    btn.classList.remove('hidden');
                    btn.classList.add('flex');
                }
            });

            // Fetch extra Firestore profile details if available
            try {
                const userDocRef = doc(db, "users", user.uid);
                const userSnap = await getDoc(userDocRef);
                
                let displayName = user.displayName || "My Profile";
                let avatarUrl = user.photoURL;

                if (userSnap.exists()) {
                    const data = userSnap.data();
                    if (data.displayName) displayName = data.displayName;
                    if (data.avatarUrl) avatarUrl = data.avatarUrl;
                }

                // Update Desktop & Mobile profile elements
                ['desktop', 'mobile'].forEach(suffix => {
                    const isMobile = suffix === 'mobile';
                    const nameEl = document.getElementById(isMobile ? 'user-name-mobile' : 'user-name-desktop');
                    const avatarImg = document.getElementById(isMobile ? 'user-avatar-mobile' : 'user-avatar-desktop');
                    const defaultIcon = document.getElementById(isMobile ? 'default-avatar-icon-mobile' : 'default-avatar-icon-desktop');

                    if (nameEl) nameEl.textContent = displayName;
                    if (avatarUrl && avatarImg) {
                        avatarImg.src = avatarUrl;
                        avatarImg.classList.remove('hidden');
                        if (defaultIcon) defaultIcon.classList.add('hidden');
                    }
                });
            } catch (error) {
                console.error("Error fetching user profile extension:", error);
            }
        } else {
            // Show guest buttons, hide profile buttons
            guestBtns.forEach(btn => {
                if (btn) {
                    btn.classList.remove('hidden');
                    btn.classList.add('flex');
                }
            });
            profileBtns.forEach(btn => btn && btn.classList.add('hidden'));
        }
    });
}

// ==========================================
// 2. CLIENT-SIDE EXIF SCRUBBING & PHOTO UPLOAD
// ==========================================
export async function scrubAndUploadImage(file, userId) {
    return new Promise((resolve, reject) => {
        if (!file.type.startsWith('image/')) {
            return reject(new Error("Invalid file type. Only images can be scrubbed and uploaded."));
        }

        const reader = new FileReader();
        reader.readAsDataURL(file);

        reader.onload = (event) => {
            const img = new Image();
            img.src = event.target.result;

            img.onload = async () => {
                // Flatten image onto canvas to automatically strip EXIF metadata
                const canvas = document.createElement('canvas');
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0);

                // Convert to clean JPEG blob (quality 0.85)
                canvas.toBlob(async (blob) => {
                    if (!blob) {
                        return reject(new Error("Canvas to Blob conversion failed."));
                    }

                    try {
                        const timestamp = Date.now();
                        const safeFileName = file.name.replace(/[^a-zA-Z0-9_.-]/g, '_');
                        const storagePath = `evidence_media/${userId}/${timestamp}_${safeFileName}`;
                        const storageRef = ref(storage, storagePath);

                        const snapshot = await uploadBytes(storageRef, blob, { contentType: 'image/jpeg' });
                        const downloadUrl = await getDownloadURL(snapshot.ref);
                        
                        resolve(downloadUrl);
                    } catch (uploadError) {
                        reject(uploadError);
                    }
                }, 'image/jpeg', 0.85);
            };

            img.onerror = (err) => reject(err);
        };

        reader.onerror = (err) => reject(err);
    });
}

// ==========================================
// 3. SHA-256 HASHING & FIRESTORE PUBLISHING
// ==========================================
export async function generateSHA256Hash(file) {
    const buffer = await file.arrayBuffer();
    const hashBuffer = await crypto.subtle.digest('SHA-256', buffer);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
}

export async function publishTestimony(submissionData, mediaFile) {
    const currentUser = auth.currentUser;
    if (!currentUser) {
        throw new Error("Authentication required to publish testimony.");
    }

    let mediaUrl = null;
    let mediaHash = null;

    if (mediaFile) {
        mediaHash = await generateSHA256Hash(mediaFile);
        mediaUrl = await scrubAndUploadImage(mediaFile, currentUser.uid);
    }

    const testimonyPayload = {
        authorId: currentUser.uid,
        authorName: currentUser.displayName || "Anonymous Witness",
        title: submissionData.title,
        content: submissionData.content,
        category: submissionData.category || "Witness Voice",
        mediaUrl: mediaUrl || null,
        mediaHash: mediaHash || null,
        createdAt: serverTimestamp(),
        status: "published",
        quadraticScore: 0,
        upvotesCount: 0
    };

    const docRef = await addDoc(collection(db, "testimonies"), testimonyPayload);
    return docRef.id;
}
