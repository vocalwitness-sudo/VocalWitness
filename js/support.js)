// js/support.js - Support, NOWPayments Crypto, & Paystack Fiat Contribution Workflow
import { showToast } from './utils.js';
import { getFunctions, httpsCallable } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-functions.js';
import { app } from './firebase.js'; // Adjust path to your firebase config initialization if needed

const functions = getFunctions(app);

export function initSupportModal() {
    const modalHtml = `
        <div id="supportModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-[10000] flex items-center justify-center p-4 hidden">
            <div class="glass max-w-md w-full rounded-3xl p-6 border border-emerald-500/30 text-white relative modal max-h-[90vh] overflow-y-auto">
                <button id="closeSupportModal" type="button" class="absolute top-4 right-4 text-zinc-400 hover:text-white text-xl p-2 z-10">✕</button>
                
                <div class="text-center mb-5">
                    <div class="w-12 h-12 bg-emerald-500/20 rounded-2xl flex items-center justify-center mx-auto mb-3 text-2xl">🛡️</div>
                    <h3 class="text-xl font-bold text-white">Sustain the Public Square</h3>
                    <p class="text-xs text-emerald-300 mt-1">VocalWitness stays free, independent, and un-manipulated through voluntary community backing.</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs text-zinc-400 mb-2">Select Contribution Amount (USD / NGN)</label>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" class="support-tier-btn py-2 bg-zinc-800 hover:bg-emerald-600/30 border border-zinc-700 rounded-xl text-sm font-medium transition-all" data-amount="5">$5</button>
                            <button type="button" class="support-tier-btn py-2 bg-zinc-800 hover:bg-emerald-600/30 border border-emerald-500 bg-emerald-600/20 rounded-xl text-sm font-medium transition-all" data-amount="15">$15</button>
                            <button type="button" class="support-tier-btn py-2 bg-zinc-800 hover:bg-emerald-600/30 border border-zinc-700 rounded-xl text-sm font-medium transition-all" data-amount="50">$50</button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs text-zinc-400 mb-1">Custom Amount ($ USD)</label>
                        <input type="number" id="customSupportAmount" placeholder="Enter amount" min="1" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" value="15">
                    </div>

                    <!-- Fiat / Paystack Option -->
                    <button id="paystackPayBtn" type="button" class="w-full py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl text-sm transition-all shadow-lg shadow-blue-600/20 flex items-center justify-center gap-2">
                        <span>💳 Pay with Card / Bank (Paystack)</span>
                    </button>

                    <!-- Crypto Option -->
                    <button id="proceedCryptoBtn" type="button" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-black font-semibold rounded-xl text-sm transition-all shadow-lg shadow-emerald-600/20">
                        Proceed with Crypto (NOWPayments) ⚡
                    </button>
                </div>

                <!-- Direct TRC-20 Wallet Transfer Option -->
                <div class="mt-5 pt-4 border-t border-zinc-800">
                    <p class="text-xs text-zinc-400 mb-2 font-medium text-center">Or scan / copy to send USDT directly:</p>
                    
                    <div class="bg-white p-3 rounded-2xl w-36 h-36 mx-auto mb-3 flex items-center justify-center shadow-md">
                        <img src="95756.jpg" alt="USDT QR Code" class="w-full h-full object-contain">
                    </div>

                    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-3 flex items-center justify-between gap-2">
                        <span class="text-[11px] text-emerald-400 font-mono truncate select-all">TDtka2ZxJHtnWc3sRygm7WWfJVZHbhkLtK</span>
                        <button type="button" id="copyTrxBtn" class="text-xs bg-zinc-800 hover:bg-zinc-700 px-3 py-1.5 rounded-lg text-white font-medium transition-all shrink-0">
                            Copy
                        </button>
                    </div>
                    <p class="text-[10px] text-zinc-500 mt-1.5 text-center">Network: <strong class="text-zinc-400">Tron (TRC-20)</strong> • Send USDT only</p>
                </div>

                <p class="text-[10px] text-zinc-500 text-center mt-4">Powered by non-custodial rails. No tracking, no intrusive data collection.</p>
            </div>
        </div>
    `;

    if (!document.getElementById('supportModal')) {
        document.body.insertAdjacentHTML('beforeend', modalHtml);
    }

    const modal = document.getElementById('supportModal');
    const closeBtn = document.getElementById('closeSupportModal');
    const proceedCryptoBtn = document.getElementById('proceedCryptoBtn');
    const paystackBtn = document.getElementById('paystackPayBtn');
    const customInput = document.getElementById('customSupportAmount');
    const copyTrxBtn = document.getElementById('copyTrxBtn');

    window.closeSupportModal = () => {
        modal?.classList.add('hidden');
    };

    document.addEventListener('click', (e) => {
        if (e.target.closest('#support-btn') || e.target.closest('#supportTheSquareBtn') || e.target.closest('.support-trigger') || e.target.closest('a[href*="support"]')) {
            if (e.target.tagName === 'A') e.preventDefault();
            modal?.classList.remove('hidden');
        }
    });

    closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        window.closeSupportModal();
    });

    modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
            window.closeSupportModal();
        }
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            window.closeSupportModal();
        }
    });

    document.querySelectorAll('.support-tier-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            document.querySelectorAll('.support-tier-btn').forEach(b => {
                b.classList.remove('border-emerald-500', 'bg-emerald-600/20');
                b.classList.add('border-zinc-700', 'bg-zinc-800');
            });
            e.target.classList.remove('border-zinc-700', 'bg-zinc-800');
            e.target.classList.add('border-emerald-500', 'bg-emerald-600/20');
            if (customInput) customInput.value = e.target.getAttribute('data-amount');
        });
    });

    proceedCryptoBtn?.addEventListener('click', () => {
        const amount = customInput?.value || 15;
        showToast(`Preparing $${amount} secure crypto invoice via NOWPayments...`, "info");
        
        setTimeout(() => {
            window.open(`https://nowpayments.io/payment?price_amount=${amount}&price_currency=usd`, '_blank');
            window.closeSupportModal();
        }, 800);
    });

    // Handle Paystack Fiat Payment using official Paystack Popups
    paystackBtn?.addEventListener('click', async () => {
        const amountVal = parseFloat(customInput?.value) || 15;
        if (amountVal < 1) {
            showToast('Please enter a valid amount', 'error');
            return;
        }

        showToast('Initializing secure payment...', 'info');

        try {
            const initialize = httpsCallable(functions, 'initializePaystack');
            const result = await initialize({
                email: 'supporter@vocalwitness.org',
                amount: Math.round(amountVal * 1650 * 100), 
                reference: `vw_support_${Date.now()}`,
                metadata: {
                    source: 'support_modal',
                    amount_usd: amountVal
                }
            });

            const { authorization_url } = result.data;
            
            if (authorization_url) {
                window.location.href = authorization_url; // Safely redirect to Paystack checkout page
            } else {
                throw new Error('No authorization URL returned from server.');
            }

        } catch (error) {
            console.error(error);
            showToast('Payment initialization failed. Please try again.', 'error');
        }
    });

    copyTrxBtn?.addEventListener('click', () => {
        navigator.clipboard.writeText('TDtka2ZxJHtnWc3sRygm7WWfJVZHbhkLtK');
        showToast('TRC-20 address copied!', 'success');
    });
}

document.addEventListener('DOMContentLoaded', () => {
    initSupportModal();
    console.log('%cSupport module loaded successfully', 'color:#10b981; font-weight:bold');
});
