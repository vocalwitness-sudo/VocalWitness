// js/support.js - Upgraded Support Module
import { showToast } from './utils.js';
import { getFunctions, httpsCallable } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-functions.js';
import { app } from './firebase.js';
import { auth } from './firebase-config.js';   // Make sure this import works in your setup

const functions = getFunctions(app);

export function initSupportModal() {
    const modalHtml = `
        <div id="supportModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-[10000] flex items-center justify-center p-4 hidden">
            <div class="glass max-w-md w-full rounded-3xl p-6 border border-emerald-500/30 text-white relative modal max-h-[90vh] overflow-y-auto">
                <button id="closeSupportModal" type="button" class="absolute top-4 right-4 text-zinc-400 hover:text-white text-xl p-2 z-10">✕</button>
                
                <div class="text-center mb-6">
                    <div class="w-14 h-14 bg-emerald-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4 text-3xl">🛡️</div>
                    <h3 class="text-2xl font-bold text-white">Sustain the Public Square</h3>
                    <p class="text-sm text-emerald-300 mt-2 leading-relaxed">
                        VocalWitness remains completely free and independent.<br>
                        No ads. No corporate control. Only voluntary community support keeps it alive.
                    </p>
                </div>

                <div class="space-y-5">
                    <div>
                        <label class="block text-xs text-zinc-400 mb-2">Choose Contribution Amount</label>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" class="support-tier-btn py-3 bg-zinc-800 hover:bg-emerald-600/30 border border-zinc-700 rounded-2xl text-sm font-medium transition-all" data-amount="5">$5</button>
                            <button type="button" class="support-tier-btn py-3 bg-zinc-800 hover:bg-emerald-600/30 border border-emerald-500 bg-emerald-600/20 rounded-2xl text-sm font-medium transition-all" data-amount="15">$15</button>
                            <button type="button" class="support-tier-btn py-3 bg-zinc-800 hover:bg-emerald-600/30 border border-zinc-700 rounded-2xl text-sm font-medium transition-all" data-amount="50">$50</button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs text-zinc-400 mb-1">Custom Amount (USD)</label>
                        <input type="number" id="customSupportAmount" placeholder="Enter amount" min="1" 
                               class="w-full bg-zinc-900 border border-zinc-800 rounded-2xl px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-500" value="15">
                    </div>

                    <button id="paystackPayBtn" type="button" 
                            class="w-full py-4 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-2xl text-base transition-all shadow-lg shadow-blue-600/20 flex items-center justify-center gap-2">
                        💳 Pay with Card or Bank Transfer (Paystack)
                    </button>

                    <button id="proceedCryptoBtn" type="button" 
                            class="w-full py-4 bg-emerald-600 hover:bg-emerald-500 text-black font-semibold rounded-2xl text-base transition-all shadow-lg shadow-emerald-600/20">
                        ⚡ Pay with Crypto (NOWPayments)
                    </button>
                </div>

                <!-- Direct Wallet -->
                <div class="mt-6 pt-5 border-t border-zinc-800">
                    <p class="text-xs text-zinc-400 mb-3 text-center">Or send USDT directly</p>
                    <div class="bg-white p-3 rounded-2xl w-40 h-40 mx-auto mb-4 flex items-center justify-center shadow-inner">
                        <img src="95756.jpg" alt="USDT QR Code" class="w-full h-full object-contain">
                    </div>
                    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex items-center justify-between gap-3">
                        <span class="text-[13px] text-emerald-400 font-mono break-all select-all">TDtka2ZxJHtnWc3sRygm7WWfJVZHbhkLtK</span>
                        <button type="button" id="copyTrxBtn" class="text-xs bg-zinc-800 hover:bg-zinc-700 px-4 py-2 rounded-xl text-white font-medium transition-all shrink-0">Copy</button>
                    </div>
                    <p class="text-[10px] text-zinc-500 mt-2 text-center">Tron (TRC-20) • USDT only</p>
                </div>

                <!-- Transparency -->
                <div class="mt-6 text-center">
                    <p class="text-[10px] text-zinc-500">
                        Every contribution supports servers, security &amp; independence.<br>
                        <a href="transparency.html" class="text-emerald-400 hover:underline">View Transparency Report →</a>
                    </p>
                </div>

                <p class="text-[10px] text-zinc-500 text-center mt-4">
                    Non-custodial • No tracking • Protects free speech
                </p>
            </div>
        </div>
    `;

    if (!document.getElementById('supportModal')) {
        document.body.insertAdjacentHTML('beforeend', modalHtml);
    }

    const modal = document.getElementById('supportModal');
    const closeBtn = document.getElementById('closeSupportModal');
    const proceedCryptoBtn = document.getElementById('proceedCryptoBtn');
    const paystackBtn = document.getElementById('paystackPayBtn');
    const customInput = document.getElementById('customSupportAmount');
    const copyTrxBtn = document.getElementById('copyTrxBtn');

    window.closeSupportModal = () => modal?.classList.add('hidden');

    // Open from anywhere
    document.addEventListener('click', (e) => {
        if (e.target.closest('#support-btn, #supportTheSquareBtn, .support-trigger, a[href*="support"]')) {
            if (e.target.tagName === 'A') e.preventDefault();
            modal?.classList.remove('hidden');
        }
    });

    closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        window.closeSupportModal();
    });

    modal?.addEventListener('click', (e) => {
        if (e.target === modal) window.closeSupportModal();
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            window.closeSupportModal();
        }
    });

    // Amount buttons
    document.querySelectorAll('.support-tier-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            document.querySelectorAll('.support-tier-btn').forEach(b => {
                b.classList.remove('border-emerald-500', 'bg-emerald-600/20');
                b.classList.add('border-zinc-700', 'bg-zinc-800');
            });
            e.target.classList.add('border-emerald-500', 'bg-emerald-600/20');
            if (customInput) customInput.value = e.target.getAttribute('data-amount');
        });
    });

    // Crypto
    proceedCryptoBtn?.addEventListener('click', () => {
        const amount = parseFloat(customInput?.value) || 15;
        showToast(`Preparing $${amount} crypto payment...`, "info");
        setTimeout(() => {
            window.open(`https://nowpayments.io/payment?price_amount=${amount}&price_currency=usd`, '_blank');
            window.closeSupportModal();
        }, 700);
    });

    // Paystack - Improved
    paystackBtn?.addEventListener('click', async () => {
        const amountVal = parseFloat(customInput?.value) || 15;
        if (amountVal < 1) return showToast('Please enter a valid amount', 'error');

        showToast('Connecting to secure payment...', 'info');

        try {
            const initialize = httpsCallable(functions, 'initializePaystack');
            const result = await initialize({
                amount: Math.round(amountVal * 1650 * 100),
                metadata: {
                    source: 'support_modal',
                    amount_usd: amountVal,
                    userId: auth.currentUser?.uid || null
                }
            });

            if (result.data.authorization_url) {
                window.location.href = result.data.authorization_url;
            } else {
                throw new Error('No authorization URL');
            }
        } catch (error) {
            console.error(error);
            showToast('Payment initialization failed. Please try again.', 'error');
        }
    });

    copyTrxBtn?.addEventListener('click', () => {
        navigator.clipboard.writeText('TDtka2ZxJHtnWc3sRygm7WWfJVZHbhkLtK');
        showToast('TRC-20 address copied!', 'success');
    });
}

// Auto init
document.addEventListener('DOMContentLoaded', () => {
    initSupportModal();
    console.log('%cSupport module loaded successfully ✓', 'color:#10b981; font-weight:bold');
});
