{
  "name": "vocalwitness-functions",
  "description": "Cloud Functions for VocalWitness",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "scripts": {
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@google-cloud/tasks": "^7.2.0",
    "@google/genai": "^2.24.0",
    "axios": "^1.20.0",
    "circomlibjs": "^0.1.7",
    "cors": "^2.8.5",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "livekit-server-sdk": "^2.19.1",
    "merkletreejs": "^0.4.0",
    "opentimestamps": "^0.4.9",
    "paystack-api": "^2.0.6",
    "rss-parser": "^3.13.0",
    "snarkjs": "^0.7.6"
  },
  "allowScripts": [
    "protobufjs",
    "re2"
  ]
}

"scripts": {
  "build:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css --minify",
  "watch:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css --watch",
  "lint": "eslint js functions --no-error-on-unmatched-pattern",
  "lint:fix": "eslint js functions --fix --no-error-on-unmatched-pattern",
  "audit:i18n": "node scripts/audit-i18n.js",
  "emulators": "firebase emulators:start",
  "test": "npx playwright test",
  "test:integrity": "node tests/integrity-core.js",
  "test:ci": "npm run test:integrity && npx playwright test --project=chromium",
  "deploy": "npm run audit:i18n && firebase deploy",
  "deploy:hosting": "npm run audit:i18n && npm run build:css && firebase deploy --only hosting",
  "deploy:functions": "firebase deploy --only functions",
  "logs": "firebase functions:log",
  "install:all": "npm install && npm --prefix functions install"
},
"devDependencies": {
  "@eslint/js": "^9.0.0",
  "@playwright/test": "^1.48.0",
  "@tailwindcss/cli": "^4.0.0",
  "eslint": "^9.0.0",
  "firebase-tools": "^13.0.0",
  "globals": "^15.0.0",
  "tailwindcss": "^4.0.0"
}
