name: Deploy to Production (Live)

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  deploy-live:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'                    # caches root node_modules

      # 1. Install root dependencies (for Tailwind / frontend build)
      - name: Install root dependencies
        run: npm install

      # 2. Install Functions dependencies (THIS was the missing step)
      - name: Install Functions dependencies
        working-directory: functions
        run: npm install                  # use "npm ci" once you commit package-lock.json

      # 3. Build production CSS
      - name: Install Tailwind CLI
        run: npm install -D tailwindcss @tailwindcss/cli

      - name: Build production CSS
        run: npx @tailwindcss/cli -i ./input.css -o ./style.css --minify

      # 4. Authenticate with Google Cloud
      - name: Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}

      # 5. Install Firebase CLI
      - name: Install Firebase Tools
        run: npm install -g firebase-tools@15.33.0

      # 6. Deploy Firestore + Storage + Functions
      - name: Deploy Firestore + Storage + Functions
        run: |
          firebase deploy \
            --only firestore,storage,functions \
            --project vocalwitness-3affa \
            --non-interactive

      # 7. Deploy Hosting (Live channel)
      - name: Deploy to Firebase Hosting (Live)
        uses: FirebaseExtended/action-hosting-deploy@v0
        with:
          repoToken: ${{ secrets.GITHUB_TOKEN }}
          firebaseServiceAccount: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
          projectId: vocalwitness-3affa
          channelId: live
          entryPoint: .
          firebaseToolsVersion: 15.33.0
