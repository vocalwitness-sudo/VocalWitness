
/**
 * functions/http/getUploadUrl.js
 */
import { onRequest } from "firebase-functions/v2/https";
import { HttpsError } from "firebase-functions/v2/https";
import admin from "firebase-admin";
import { PutObjectCommand } from "@aws-sdk/client-s3";
import { getSignedUrl } from "@aws-sdk/s3-request-presigner";
import { getR2Client } from "../lib/r2.js";
import { enforceRateLimit } from "../lib/rate-limit.js";
import { writeAuditLog } from "../lib/audit.js";

export function createGetUploadUrl({
  allowedOrigins,
  corsHandler,
  r2AccessKeyId,
  r2SecretAccessKey,
}) {
  return onRequest(
    {
      cors: allowedOrigins,
      secrets: [r2AccessKeyId, r2SecretAccessKey],
    },
    (req, res) => {
      corsHandler(req, res, async () => {
        if (req.method === "OPTIONS") return res.status(204).send("");
        if (req.method !== "POST") {
          return res.status(405).json({ error: "Method Not Allowed" });
        }

        try {
          const appCheckToken = req.headers["x-firebase-appcheck"];
          if (!appCheckToken) {
            return res.status(401).json({ error: "Unauthorized: Missing App Check token." });
          }
          try {
            await admin.appCheck().verifyToken(appCheckToken);
          } catch {
            return res.status(403).json({ error: "Forbidden: Invalid App Check token." });
          }

          const authHeader = req.headers.authorization;
          if (!authHeader?.startsWith("Bearer ")) {
            return res.status(401).json({ error: "Unauthorized. ID token required." });
          }
          const idToken = authHeader.split("Bearer ")[1];
          const decodedToken = await admin.auth().verifyIdToken(idToken);
          const uid = decodedToken.uid;

          await enforceRateLimit(uid, "getUploadUrl", { windowMs: 60_000, max: 10 });

          const { fileName, fileType } = req.body || {};
          if (
            !fileName ||
            typeof fileName !== "string" ||
            !fileType ||
            typeof fileType !== "string"
          ) {
            return res
              .status(400)
              .json({ error: "fileName and fileType must be non-empty strings." });
          }

          const allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif",
            "audio/webm",
            "audio/mpeg",
            "audio/mp4",
            "audio/wav",
            "audio/ogg",
            "video/mp4",
            "video/webm",
            "video/quicktime",
          ];
          if (!allowedTypes.includes(fileType.toLowerCase())) {
            return res.status(400).json({
              error:
                "Unsupported file type. Allowed: JPEG, PNG, WebP, GIF, WebM, MP3, MP4, WAV, OGG, MOV.",
            });
          }

          const sanitizedName = fileName
            .replace(/[^a-zA-Z0-9.\-_]/g, "_")
            .slice(0, 120);
          const objectKey = `uploads/${uid}/${Date.now()}-${sanitizedName}`;

          const s3Client = getR2Client(
            r2AccessKeyId.value(),
            r2SecretAccessKey.value()
          );
          const command = new PutObjectCommand({
            Bucket: "vocalwitness-media",
            Key: objectKey,
            ContentType: fileType,
          });

          const uploadUrl = await getSignedUrl(s3Client, command, {
            expiresIn: 900,
          });
          const publicUrl = `https://media.vocalwitness.com/${objectKey}`;

          await writeAuditLog({
            action: "upload_url_issued",
            performedBy: uid,
            targetId: objectKey,
            targetType: "media",
            details: { fileType, fileName: sanitizedName },
            severity: "info",
          });

          return res.status(200).json({ uploadUrl, publicUrl, key: objectKey });
        } catch (error) {
          if (error instanceof HttpsError && error.code === "resource-exhausted") {
            return res.status(429).json({ error: error.message });
          }
          console.error("Error generating pre-signed URL:", error);
          return res.status(500).json({ error: "Failed to generate upload URL." });
        }
      });
    }
  );
}
